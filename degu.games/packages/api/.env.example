# Database
DATABASE_URL="postgresql://username:password@localhost:5432/scratch_editor_db?schema=public"

# FAL AI (Fashion Try-On)
FAL_KEY=your_fal_api_key_here

# Gemini AI (Image Enhancement)
GEMINI_API_KEY=your_gemini_api_key_here

# Remove.bg (Background Removal)
REMOVE_BG_API_KEY=your_remove_bg_api_key_here

# Server
PORT=3000
NODE_ENV=development

# CORS Configuration
# Comma-separated list of allowed origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:8601,http://localhost:8602

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars_change_in_production
JWT_EXPIRES_IN=7d

# Privy Authentication (Backend)
PRIVY_APP_ID=your_privy_app_id_here
PRIVY_APP_SECRET=your_privy_app_secret_here

# Blockchain Configuration (Westend Asset Hub - PolkaVM)
POLKAVM_RPC_URL=https://westend-asset-hub-eth-rpc.polkadot.io
DEGU_TOKEN_ADDRESS=
BETTING_CONTRACT_ADDRESS=

# Base Testnet Configuration
BASE_TESTNET_RPC=https://sepolia.base.org
GAME_ESCROW_ADDRESS=0x90c15373A1db6c75A55CfD3743249D56136Cb86a
USDC_BASE_TESTNET=0xE02E0dEa9F850D88E1329550D9FC8D98aF541f55
ORACLE_PRIVATE_KEY=your_oracle_private_key_here

# VM Server Integration
VM_SERVER_URL=http://localhost:3002
VM_SERVER_TOKEN=vm_server_secret_token_here
