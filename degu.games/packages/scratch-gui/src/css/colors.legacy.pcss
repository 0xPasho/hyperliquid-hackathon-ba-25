/* Legacy PostCSS simple-vars variable definitions split out to avoid editor CSS parse errors. */
/* This file is processed by postcss-simple-vars via @import in colors.css. */
/* Premium futuristic dark purple/pink theme */

$ui-primary: #12121A; /* Darker card background */
$ui-secondary: #1A1A25; /* Darker surface */
$ui-tertiary: #222233; /* Darker divider with purple tint */

$ui-modal-overlay: rgba(180, 0, 255, 0.4); /* Stronger purple glow overlay */

$ui-white: #FFFFFF; /* Pure white */
$ui-white-dim: rgba(255, 255, 255, 0.75); /* Dimmed white */
$ui-white-transparent: rgba(255, 255, 255, 0.15); /* More subtle transparent white */
$ui-transparent: rgba(0, 0, 0, 0); /* Fully transparent */

$ui-black-transparent: rgba(34, 34, 51, 0.6); /* Darker with purple tint */
$ui-black-transparent-10: rgba(34, 34, 51, 0.3); /* Lighter variant */

$ui-green: #00FF88; /* Brighter neon green */
$ui-green-2: #33FF99; /* Lighter neon green */

$text-primary: #FFFFFF; /* Pure white text */
$text-primary-transparent: rgba(255, 255, 255, 0.75); /* Transparent white text */

$motion-primary: #B000FF; /* Deeper saturated purple */
$motion-tertiary: #8800CC; /* Darker purple */

$looks-secondary: #B000FF; /* Neon purple */
$looks-transparent: rgba(180, 0, 255, 0.4); /* Stronger transparent purple */
$looks-light-transparent: rgba(180, 0, 255, 0.2); /* Light transparent purple */
$looks-secondary-dark: #8800CC; /* Darker purple */

$red-primary: #FF1744; /* Brighter red */
$red-tertiary: #CC0033; /* Darker red */

$sound-primary: #FF0AA6; /* Brighter vibrant pink */
$sound-tertiary: #CC0085; /* Darker pink */

$control-primary: #FFAA00; /* More saturated yellow/orange */

$data-primary: #FF8800; /* Brighter orange */

$pen-primary: #00FF88; /* Neon green */
$pen-transparent: rgba(0, 255, 136, 0.25); /* Transparent neon green */
$pen-tertiary: #00CC66; /* Darker green */

$error-primary: #FF1744; /* Bright error red */
$error-light: #FF4466; /* Lighter error */
$error-transparent: rgba(255, 23, 68, 0.25); /* Transparent error */

$extensions-primary: #00FF88; /* Neon green */
$extensions-tertiary: #00CC66; /* Darker green */
$extensions-transparent: rgba(0, 255, 136, 0.35); /* Transparent green */
$extensions-light: rgba(0, 255, 136, 0.2); /* Light green tint */

$drop-highlight: #B000FF; /* Neon purple glow */
