# Server Configuration
PORT=3002
NODE_ENV=development

# Capacity Limits
MAX_CONCURRENT_GAMES=200
MAX_QUEUE_SIZE=1000

# Performance Settings
STATE_BROADCAST_FPS=20
INPUT_RATE_LIMIT=100

# Backend Integration (API server URL)
BACKEND_URL=http://localhost:3000/api/v1
VM_SERVER_TOKEN=vm_server_secret_token_here

# Authentication (must match API's VM_SERVER_TOKEN)
# This token is used to authenticate requests FROM the API server TO this VM server

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/vm-server.log

# Project Storage
# Option 1: Load from file system
PROJECT_STORAGE_PATH=./projects

# Option 2: Load from backend API
# PROJECT_API_URL=http://localhost:3000/api/projects
